struct ModuleDescriptor {
    ModuleID              id;
    std::string           name;
    std::string           version;
    std::string           description;
    std::vector<ModuleID> dependencies;        ///< Direct hard dependencies
    std::vector<ModuleID> soft_dependencies;   ///< Optional / weak links
    std::vector<ModuleID> provides;            ///< Virtual IDs this module satisfies
    ConfigMap             default_config;
    ConfigMap             env_overrides;
    TopologyType          preferred_topology{TopologyType::FLAT};
    double                priority{1.0};       ///< Resolution priority weight
    bool                  lazy{false};         ///< Defer loading until first use
    bool                  singleton{true};     ///< Single instance per registry

    [[nodiscard]] bool has_dependency(const ModuleID& dep) const noexcept {
        return std::ranges::find(dependencies, dep) != dependencies.end()
            || std::ranges::find(soft_dependencies, dep) != soft_dependencies.end();
    }
};

