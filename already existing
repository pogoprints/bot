enum class LogLevel : uint8_t {
    TRACE = 0,
    DEBUG = 1,
    INFO = 2,
    WARN = 3,
    ERROR = 4,
    FATAL = 5
};

constexpr std::string_view log_level_to_str(LogLevel l) noexcept {
    switch (l) {
    case LogLevel::TRACE: return "TRACE";
    case LogLevel::DEBUG: return "DEBUG";
    case LogLevel::INFO:  return "INFO ";
    case LogLevel::WARN:  return "WARN ";
    case LogLevel::ERROR: return "ERROR";
    case LogLevel::FATAL: return "FATAL";
    default:              return "?????";
    }
}

class Logger {
public:
    using Sink = std::function<void(LogLevel, std::string_view)>;

    static Logger& instance() noexcept {
        static Logger s_instance;
        return s_instance;
    }

    void set_level(LogLevel l) noexcept { min_level_.store(l, std::memory_order_relaxed); }
    [[nodiscard]] LogLevel level() const noexcept { return min_level_.load(std::memory_order_relaxed); }

    void add_sink(Sink s) {
        std::lock_guard lk{mtx_};
        sinks_.push_back(std::move(s));
    }

    void log(LogLevel lvl, std::string_view msg,
             const std::source_location& loc = std::source_location::current()) {
        if (lvl < min_level_.load(std::memory_order_relaxed)) return;

        auto now = std::chrono::system_clock::now();
        auto ts  = std::chrono::duration_cast<std::chrono::microseconds>(
                       now.time_since_epoch()).count();

        std::string entry = std::format(
            "[{:>16}µs] [{}] [{}:{}] {}",
            ts, log_level_to_str(lvl),
            std::filesystem::path(loc.file_name()).filename().string(),
            loc.line(), msg);

        std::lock_guard lk{mtx_};
        for (auto& s : sinks_) s(lvl, entry);
    }

    template <typename... Args>
    void logf(LogLevel lvl, std::format_string<Args...> fmt, Args&&... args,
              const std::source_location& loc = std::source_location::current()) {
        log(lvl, std::format(fmt, std::forward<Args>(args)...), loc);
    }

private:
    Logger() {
        sinks_.push_back([](LogLevel, std::string_view msg) {
            std::cout << msg << '\n';
        });
    }
    std::atomic<LogLevel> min_level_{LogLevel::INFO};
    std::mutex mtx_;
    std::vector<Sink> sinks_;
};

#define UMRE_LOG(level, msg) \
    ::umre::Logger::instance().log(level, msg, std::source_location::current())

#define UMRE_LOGF(level, fmt, ...) \
    ::umre::Logger::instance().log( \
        level, std::format(fmt, __VA_ARGS__), std::source_location::current())

#define UMRE_TRACE(msg)  UMRE_LOG(::umre::LogLevel::TRACE, msg)
#define UMRE_DEBUG(msg)  UMRE_LOG(::umre::LogLevel::DEBUG, msg)
#define UMRE_INFO(msg)   UMRE_LOG(::umre::LogLevel::INFO,  msg)
#define UMRE_WARN(msg)   UMRE_LOG(::umre::LogLevel::WARN,  msg)
#define UMRE_ERROR(msg)  UMRE_LOG(::umre::LogLevel::ERROR, msg)
#define UMRE_FATAL(msg)  UMRE_LOG(::umre::LogLevel::FATAL, msg)

