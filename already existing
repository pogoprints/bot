class NullModuleLoader final : public IModuleLoader {
public:
    std::any load(const ModuleDescriptor& desc, const ConfigMap&) override {
        UMRE_LOGF(LogLevel::DEBUG, "NullLoader: loaded module '{}'", desc.id);
        return std::make_any<std::string>(desc.id);
    }
    void unload(const ModuleID& id, std::any&) override {
        UMRE_LOGF(LogLevel::DEBUG, "NullLoader: unloaded module '{}'", id);
    }
