class IModuleLoader {
public:
    virtual ~IModuleLoader() = default;

    /// Load the module and return an opaque handle
    virtual std::any load(const ModuleDescriptor& desc, const ConfigMap& cfg) = 0;

    /// Unload a previously loaded module
    virtual void unload(const ModuleID& id, std::any& handle) = 0;

    /// Check whether this loader can handle the given descriptor
    [[nodiscard]] virtual bool can_load(const ModuleDescriptor& desc) const noexcept = 0;

    /// Return a human-readable loader name
    [[nodiscard]] virtual std::string_view name() const noexcept = 0;
};

// ============================================================
