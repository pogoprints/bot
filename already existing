}

// ============================================================
//  Pathway representation
// ============================================================

struct PathwayEdge {
    NodeID   from{0};
    NodeID   to{0};
    EdgeWeight weight{1.0};
    EdgeWeight latency{0.0};
    EdgeWeight bandwidth{std::numeric_limits<double>::max()};
    bool     directed{true};
    bool     active{true};
    std::string label;

    [[nodiscard]] bool is_valid() const noexcept {
        return from != to && weight >= 0.0 && latency >= 0.0 && bandwidth > 0.0;
    }
};

struct PathwayNode {
    NodeID      id{0};
    ModuleID    module_id;
    std::string label;
    double      compute_cost{0.0};
    double      memory_cost{0.0};
    bool        is_gateway{false};
    bool        is_terminal{false};
    ConfigMap   attributes;

    [[nodiscard]] double total_cost() const noexcept {
        return compute_cost + memory_cost;
    }
};

struct OptimalPathway {
    std::vector<NodeID>   nodes;
    std::vector<PathwayEdge> edges;
    double total_weight{0.0};
    double total_latency{0.0};
    double min_bandwidth{0.0};
    bool   is_feasible{false};
    std::string resolution_strategy;
    std::chrono::nanoseconds computation_time{0};

    [[nodiscard]] size_t hop_count() const noexcept {
        return nodes.empty() ? 0 : nodes.size() - 1;
    }

    [[nodiscard]] std::string to_string() const {
        std::ostringstream oss;
        oss << "OptimalPathway{"
            << "hops=" << hop_count()
            << ", weight=" << total_weight
            << ", latency=" << total_latency
            << ", bw=" << min_bandwidth
            << ", feasible=" << (is_feasible ? "yes" : "no")
            << ", strategy=" << resolution_strategy
            << "}";
        return oss.str();
    }
};

