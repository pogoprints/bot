template <typename T>
concept ModuleConfigurableType =
    std::is_default_constructible_v<T> && std::is_copy_constructible_v<T>;

template <typename T>
concept PathwayWeightType =
    std::is_arithmetic_v<T> && std::totally_ordered<T>;

template <typename T>
concept SerializableType = requires(T t) {
    { t.serialize() } -> std::convertible_to<std::string>;
    { T::deserialize(std::string{}) } -> std::same_as<T>;
};

